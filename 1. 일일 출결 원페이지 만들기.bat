@echo off
title 일일 출결 원페이지 만들기
cd /d "%~dp0"

echo ============================================================
echo  조회할 대상 날짜를 입력하세요 (예: YYYY-MM-DD)
echo  예: 2026-05-20
echo  [엔터]를 그냥 누르면 가장 최근일로 자동 진행합니다.
echo ============================================================
set /p USER_DATE="날짜 입력: "

if "%USER_DATE%"=="" (
    python "1. 일일 출결 원페이지 만들기.py"
) else (
    python "1. 일일 출결 원페이지 만들기.py" %USER_DATE%
)

pause