@echo off
title 주간 출결 원페이지 만들기
cd /d "%~dp0"

echo ============================================================
echo  조회할 주간의 날짜를 입력하세요 (예: YYYY-MM-DD)
echo  예: 해당 주의 2026-05-11 입력
echo  [엔터]를 그냥 누르면 가장 최근 대상 주간으로 자동 진행합니다.
echo ============================================================
set /p USER_DATE="날짜 입력: "

if "%USER_DATE%"=="" (
    python "2. 주간 출결 원페이지 만들기.py"
) else (
    python "2. 주간 출결 원페이지 만들기.py" %USER_DATE%
)

pause